# Server Port (Render sets this dynamically via $PORT in production)
PORT=5000

# Environment Mode (production / development)
NODE_ENV=development

# MongoDB Connection String (Atlas URI in production or local mongod)
MONGODB_URI=mongodb://127.0.0.1:27017/ldews

# JWT Authentication Secret
JWT_SECRET=demo-secret-key-sih2026

# Production Frontend URL (Vercel deployment)
